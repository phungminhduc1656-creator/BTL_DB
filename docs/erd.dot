digraph ERD {
  graph [rankdir=LR, bgcolor="#fafcf8", pad="0.5", nodesep="0.55", ranksep="0.8", label="COURTLY  |  ERD — QUẢN LÝ ĐẶT SÂN PICKLEBALL", labelloc=t, fontsize=20, fontname="Segoe UI"];
  node [shape=plain, fontname="Segoe UI"];
  edge [color="#5b796b", penwidth=1.5, fontname="Segoe UI", fontsize=10, arrowhead=crow, arrowsize=0.8];
  customers [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#b7c8bd"><TR><TD BGCOLOR="#173e32"><FONT COLOR="white"><B>customers</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK  id : BIGINT<BR ALIGN="LEFT"/>full_name : VARCHAR(100)<BR ALIGN="LEFT"/>UQ  phone : VARCHAR(20)<BR ALIGN="LEFT"/>email : VARCHAR(254)</TD></TR></TABLE>>];
  bookings [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#b7c8bd"><TR><TD BGCOLOR="#173e32"><FONT COLOR="white"><B>bookings</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK  id : BIGINT<BR ALIGN="LEFT"/>UQ  booking_code : VARCHAR(50)<BR ALIGN="LEFT"/>FK  customer_id : BIGINT<BR ALIGN="LEFT"/>status : VARCHAR(16)<BR ALIGN="LEFT"/>note : VARCHAR(500)<BR ALIGN="LEFT"/>created_at : DATETIME<BR ALIGN="LEFT"/>cancelled_at : DATETIME</TD></TR></TABLE>>];
  booking_items [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#b7c8bd"><TR><TD BGCOLOR="#173e32"><FONT COLOR="white"><B>booking_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK  id : BIGINT<BR ALIGN="LEFT"/>FK  booking_id : BIGINT<BR ALIGN="LEFT"/>FK  court_id : BIGINT<BR ALIGN="LEFT"/>play_date : DATE<BR ALIGN="LEFT"/>FK  time_slot_id : BIGINT<BR ALIGN="LEFT"/>unit_price : DECIMAL(12,0)<BR ALIGN="LEFT"/>released_at : DATETIME<BR ALIGN="LEFT"/>active_guard : TINYINT (generated)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e4efc8">UNIQUE (court_id, play_date,<BR ALIGN="LEFT"/>time_slot_id, active_guard)</TD></TR></TABLE>>];
  courts [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#b7c8bd"><TR><TD BGCOLOR="#173e32"><FONT COLOR="white"><B>courts</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK  id : BIGINT<BR ALIGN="LEFT"/>UQ  code : VARCHAR(20)<BR ALIGN="LEFT"/>name : VARCHAR(100)<BR ALIGN="LEFT"/>description : VARCHAR(500)<BR ALIGN="LEFT"/>hourly_price : DECIMAL(12,0)<BR ALIGN="LEFT"/>status : VARCHAR(16)</TD></TR></TABLE>>];
  time_slots [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#b7c8bd"><TR><TD BGCOLOR="#173e32"><FONT COLOR="white"><B>time_slots</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK  id : BIGINT<BR ALIGN="LEFT"/>start_time : TIME<BR ALIGN="LEFT"/>end_time : TIME<BR ALIGN="LEFT"/>UNIQUE (start_time, end_time)</TD></TR></TABLE>>];
  payments [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#b7c8bd"><TR><TD BGCOLOR="#173e32"><FONT COLOR="white"><B>payments</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK  id : BIGINT<BR ALIGN="LEFT"/>FK, UQ  booking_id : BIGINT<BR ALIGN="LEFT"/>amount : DECIMAL(12,0)<BR ALIGN="LEFT"/>method : VARCHAR(16)<BR ALIGN="LEFT"/>paid_at : DATETIME</TD></TR></TABLE>>];
  app_users [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#b7c8bd"><TR><TD BGCOLOR="#173e32"><FONT COLOR="white"><B>app_users</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK  id : BIGINT<BR ALIGN="LEFT"/>UQ  username : VARCHAR(50)<BR ALIGN="LEFT"/>password_hash : VARCHAR(255)<BR ALIGN="LEFT"/>display_name : VARCHAR(100)<BR ALIGN="LEFT"/>role : VARCHAR(16)<BR ALIGN="LEFT"/>FK, UQ  customer_id : BIGINT (NULL with ADMIN)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff4eb">Đăng nhập ADMIN / CUSTOMER<BR ALIGN="LEFT"/>CUSTOMER có hồ sơ khách<BR ALIGN="LEFT"/>Mật khẩu băm BCrypt</TD></TR></TABLE>>];
  customers -> app_users [label="0..1 : 0..1", arrowhead=odot];
  customers -> bookings [label="1 : N"];
  bookings -> booking_items [label="1 : N"];
  courts -> booking_items [label="1 : N"];
  time_slots -> booking_items [label="1 : N"];
  bookings -> payments [label="1 : 0..1", arrowhead=odot];
}
